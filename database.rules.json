{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$gameId": {
        // Anyone with the room code can read the room (game links load before sign-in
        // finishes); the list of all rooms stays private.
        ".read": true,
        // Create a new room, or delete one that is marked for deletion (or already gone).
        ".write": "(!data.exists() && newData.child('state').val() === 'waiting') || (!newData.exists() && (!data.exists() || data.child('state').val() === 'deleting'))",
        ".validate": "$gameId.length <= 128 && newData.hasChild('state')",
        "state": {
          // shuffling/playing are set only by the flashNames function.
          ".write": "data.exists()",
          ".validate": "newData.isString() && newData.val().matches(/^(waiting|resetting|deleting)$/)"
        },
        "users": {
          // Resetting a room clears the whole player list.
          ".write": "auth != null && !newData.exists() && data.parent().child('state').val() === 'resetting'",
          "$userId": {
            // Players edit their own entry and add new fake players; anyone may remove themselves.
            ".write": "auth != null && ($userId === auth.uid || (!data.exists() && newData.child('fakeBadge').val() === true)) && (!newData.exists() || data.parent().parent().child('state').exists())",
            ".validate": "newData.hasChildren(['real', 'clan', 'fake'])",
            "real": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "clan": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "fake": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "game": { ".validate": "newData.isString() && newData.val() === $gameId" },
            "fakeBadge": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        // Shuffled secret names are written only by the flashNames function.
        "names": { ".validate": false },
        "$other": { ".validate": false }
      }
    }
  }
}

{
  "rules": {
    ".read": false,
    ".write": false,
    // A short recorded sample for the voice volume slider, written by flashNames only.
    "voiceSample": { ".read": true },
    // Room name -> password -> room key. Reading needs both the name and the password, and
    // names can't be listed. A name holds one room at a time: it can only be claimed while
    // unused, in the same write that creates the room, and is freed when the room is deleted.
    "roomNames": {
      "$name": {
        "$pass": {
          ".read": true,
          ".write": "auth != null && ((newData.exists() && !data.parent().exists() && !root.child('games').child(newData.val()).exists() && newData.parent().parent().parent().child('games').child(newData.val()).child('name').val() === $name && newData.parent().parent().parent().child('games').child(newData.val()).child('pass').val() === $pass) || (!newData.exists() && (!data.exists() || !newData.parent().parent().parent().child('games').child(data.val()).exists())))",
          ".validate": "newData.isString() && newData.val().length === 20"
        }
      }
    },
    "games": {
      "$gameId": {
        // Create a new room, together with its /roomNames entry, or delete one that is marked
        // for deletion (or already gone). Nothing can list every room.
        ".write": "auth != null && ((!data.child('state').exists() && newData.child('state').val() === 'waiting' && newData.parent().parent().child('roomNames').child(newData.child('name').val()).child(newData.child('pass').val()).val() === $gameId) || (!newData.exists() && (!data.exists() || (data.child('state').val() === 'deleting' && data.child('users').child(auth.uid).exists()))))",
        ".validate": "$gameId.length <= 128 && newData.hasChild('state')",
        "state": {
          // Readable by anyone with the room code (game links load before sign-in finishes).
          ".read": true,
          // Members control the room. Waiting is only a completed reveal; the server finishes resets.
          ".write": "auth != null && data.parent().child('users').child(auth.uid).exists() && ((newData.val().matches(/^(resetting|deleting)$/) && data.val() !== 'resetting' && data.val() !== 'deleting') || (newData.val() === 'waiting' && data.val() === 'playing' && data.parent().child('revealEndsAt').isNumber() && now >= data.parent().child('revealEndsAt').val()))",
          ".validate": "newData.isString() && newData.val().matches(/^(waiting|resetting|deleting)$/)"
        },
        "users": {
          ".read": true,
          // Only the server clears the whole roster during a reset.
          ".write": false,
          "$userId": {
            // Players edit or remove themselves; anyone in the room can add or remove fake
            // players, and remove a player who has been offline for 10 minutes. Once the names
            // have been revealed the room is locked: no joining, renaming or new bots until the
            // next round (removals still work).
            ".write": "auth != null && (($userId === auth.uid && (!newData.exists() || (data.parent().parent().child('state').val() === 'waiting' && data.parent().parent().child('locked').val() !== true))) || (data.parent().parent().child('users').child(auth.uid).exists() && ((!data.exists() && newData.child('fakeBadge').val() === true && data.parent().parent().child('state').val() === 'waiting' && data.parent().parent().child('locked').val() !== true) || (!newData.exists() && data.child('fakeBadge').val() === true) || (!newData.exists() && ((data.parent().parent().child('presence').child($userId).child('version').val() === 2 && !data.parent().parent().child('presence').child($userId).child('connections').hasChildren()) || (data.parent().parent().child('presence').child($userId).child('version').val() !== 2 && data.parent().parent().child('presence').child($userId).child('online').val() === false)) && data.parent().parent().child('presence').child($userId).child('lastSeen').val() < now - 600000))))",
            ".validate": "newData.hasChildren(['real', 'clan'])",
            "real": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "clan": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "game": { ".validate": "newData.isString() && newData.val() === $gameId" },
            "fakeBadge": { ".validate": "newData.isBoolean()" },
            // Avatar crest: "shape.color.pattern.emblem.metal" (see public/crest.js).
            "crest": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,12}(\\.[a-z]{2,12}){4}$/)" },
            // Legacy: pages loaded before secrets moved to /secrets still send this.
            "fake": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "$other": { ".validate": false }
          }
        },
        "secrets": {
          // Secret names are never readable by players; only the flashNames function reads them.
          ".write": false,
          "$userId": {
            // Your own secret, a new fake player's secret (written together with the fake),
            // or cleanup of a secret whose player is being removed in the same update.
            ".write": "auth != null && (($userId === auth.uid && (!newData.exists() || (data.parent().parent().child('state').val() === 'waiting' && data.parent().parent().child('locked').val() !== true))) || (data.parent().parent().child('users').child(auth.uid).exists() && newData.exists() && !data.exists() && newData.parent().parent().child('users').child($userId).child('fakeBadge').val() === true && data.parent().parent().child('locked').val() !== true) || (!newData.exists() && !newData.parent().parent().child('users').child($userId).exists()))",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          }
        },
        "presence": {
          ".read": true,
          "$userId": {
            // Players in the room can also remove a watcher (someone present but not a player).
            ".write": "auth != null && ($userId === auth.uid || (!newData.exists() && !data.parent().parent().child('users').child($userId).exists() && data.parent().parent().child('users').child(auth.uid).exists()))",
            ".validate": "newData.hasChild('lastSeen') && (newData.child('version').val() === 2 || (data.child('version').val() !== 2 && newData.hasChild('online')))",
            "version": { ".validate": "newData.val() === 2" },
            "connections": {
              "$connectionId": {
                ".validate": "newData.hasChildren(['away', 'name'])",
                "away": { ".validate": "newData.isBoolean()" },
                "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
                "$other": { ".validate": false }
              }
            },
            "online": { ".validate": "newData.isBoolean()" },
            "away": { ".validate": "newData.isBoolean()" },
            "lastSeen": { ".validate": "newData.isNumber() && newData.val() <= now" },
            // Display name for spectators (people watching a locked room).
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "$other": { ".validate": false }
          }
        },
        // The shuffled list shown during a reveal and when it started (so a player who reloads
        // mid-reveal rejoins at the right moment instead of getting a replay). Written only by
        // the flashNames function; the first reveal also locks the room until the next round.
        "names": { ".read": true, ".validate": false },
        "replay": { ".read": true, ".validate": false },
        // Reveal ownership is private: it must never associate a player with their secret.
        "nameOwners": { ".read": false, ".validate": false },
        "startedAt": { ".read": true, ".validate": false },
        "revealEndsAt": { ".read": true, ".validate": false },
        "locked": { ".read": true, ".validate": false },
        "roundId": { ".read": true, ".validate": false },
        "revealId": { ".read": true, ".validate": false },
        // Recorded names for the reveal (MP3, base64), written by flashNames only.
        "voice": { ".read": true, ".validate": false },
        // A bot removed after the names were revealed. A player flags it (true) in the same
        // update that removes the bot; the flashNames-side trigger then fills in its secret name
        // and recording so every device can announce it.
        "eliminated": {
          ".read": true,
          "$userId": {
            ".write": "auth != null && data.parent().parent().child('users').child(auth.uid).exists() && !data.exists() && newData.val() === true && data.parent().parent().child('locked').val() === true && data.parent().parent().child('users').child($userId).child('fakeBadge').val() === true"
          }
        },
        // Players captured into an empire once the round has started: captures/<captured> is
        // { leader, via }, where via is the player who was claimed directly (a leader's followers
        // move with them and share the via, keeping their old via in back, so one undo returns them). Humans only; the leader
        // must be an uncaptured human. Anyone in the room can claim or undo.
        "captures": {
          ".read": true,
          "$userId": {
            ".write": "auth != null && data.parent().parent().child('users').child(auth.uid).exists() && (!newData.exists() || data.parent().parent().child('locked').val() === true)",
            ".validate": "newData.hasChildren(['leader', 'via']) && newData.parent().parent().child('users').child($userId).exists() && newData.parent().parent().child('users').child($userId).child('fakeBadge').val() !== true",
            "leader": { ".validate": "newData.isString() && newData.val() !== $userId && newData.parent().parent().parent().child('users').child(newData.val()).exists() && newData.parent().parent().parent().child('users').child(newData.val()).child('fakeBadge').val() !== true && !newData.parent().parent().child(newData.val()).exists()" },
            "via": { ".validate": "newData.isString() && newData.parent().parent().parent().child('users').child(newData.val()).exists()" },
            "back": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        },
        // The room's public name and its password, set once when the room is created. Anyone
        // who reached the room can read them (the lobby shows both so players can invite others).
        "name": { ".read": true, ".validate": "newData.isString() && newData.val().length <= 32 && newData.val().matches(/^[a-z0-9]+(-[a-z0-9]+)*$/)" },
        "pass": { ".read": true, ".validate": "newData.isString() && newData.val().matches(/^[A-HJKMNP-Z]{6}$/)" },
        // Set when the room is created; used to clean up abandoned rooms.
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    }
  }
}

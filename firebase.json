{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "public",
    "headers": [
      {
        "source": "/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/manifest.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "predeploy": [
      "npm run build"
    ]
  },
  "functions": {
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint"
    ],
    "source": "functions"
  },
  "emulators": {
    "auth": {
      "host": "0.0.0.0",
      "port": 19099
    },
    "database": {
      "host": "0.0.0.0",
      "port": 19000
    },
    "functions": {
      "host": "0.0.0.0",
      "port": 15001
    },
    "hosting": {
      "host": "0.0.0.0",
      "port": 15000
    },
    "ui": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 14000
    },
    "hub": {
      "port": 14400,
      "host": "127.0.0.1"
    },
    "logging": {
      "port": 14500,
      "host": "127.0.0.1"
    },
    "singleProjectMode": false,
    "eventarc": {
      "host": "127.0.0.1",
      "port": 14299
    },
    "tasks": {
      "host": "127.0.0.1",
      "port": 14499
    }
  }
}

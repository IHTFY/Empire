{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "serve": "pnpm --dir .. dev",
    "shell": "firebase functions:shell",
    "start": "pnpm shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/room-state.test.cjs test/rounds.test.cjs test/bot-rereads.test.cjs test/presence.test.cjs test/emulators.test.cjs",
    "test:rules": "node --test test/rules.test.cjs"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.0.0"
  },
  "private": true
}
